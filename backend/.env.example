PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-in-production
DATABASE_URL=mysql://app_backend:your-db-password@127.0.0.1:3306/reframe_live

# Comma-separated list of browser origins allowed to call this API (CORS).
# Optional -- if unset, defaults to the production domain (apex + www) plus
# common local-dev origins (see server.js). Only needed here if you're
# adding a staging domain or a non-default local dev port/tool.
CORS_ALLOWED_ORIGINS=

# Email notifications (optional) -- if any of the required vars below are
# missing, the app runs exactly as before with in-app notifications only;
# nothing else breaks. Set all four required vars to enable outbound email.
# Required:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional:
SMTP_SECURE=false
SMTP_FROM="Training System <no-reply@example.com>"

# Where the public events.html registration form's alert email goes (optional).
# If unset, registrations still save to the database normally -- only the
# staff alert email is skipped (logged as a warning server-side).
EVENT_REGISTRATION_EMAIL=

# AI Assistant (optional) -- if unset, POST /api/ai/chat returns a clear
# 503 instead of the app failing to start. Get a key from
# https://platform.deepseek.com -- never commit a real key here, and never
# expose it to any public/*.html file.
DEEPSEEK_API_KEY=
