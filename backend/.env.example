# Copy this file to .env and fill in real values before running the server.

PORT=3000

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# How long a login session stays valid
JWT_EXPIRES_IN=8h

# Prefix used for auto-generated member/user IDs (TTR001, TTR002, ...)
ID_PREFIX=TTR

# How many digits to zero-pad the number to (3 -> 001, 002 ... 999, then 1000, 1001 ...)
ID_PAD_LENGTH=3

# SQLite database file location
DB_FILE=./db/reframe.sqlite

# Comma-separated list of origins allowed to call this API from the browser.
# Add your real frontend URL(s) here in production.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000

# Used only by db/seedAdmin.js to create the very first admin account.
SEED_ADMIN_ID=ADMIN001
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Administrator
