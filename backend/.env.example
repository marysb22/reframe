PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-in-production
DATABASE_URL=mysql://app_backend:your-db-password@127.0.0.1:3306/reframe_live

# Email notifications (optional) -- if any of the required vars below are
# missing, the app runs exactly as before with in-app notifications only;
# nothing else breaks. Set all four required vars to enable outbound email.
# Required:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional:
SMTP_SECURE=false
SMTP_FROM="Training System <no-reply@example.com>"
